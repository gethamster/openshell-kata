{
  "version": 1,
  "profile": "docker-vm",
  "resources": {
    "vcpus": 1,
    "memory_mib": 2048,
    "disk_mib": 2048,
    "lifetime_secs": 3600
  },
  "filesystem": {
    "host_mounts": "deny",
    "transfer_max_bytes": 268435456,
    "transfer_max_entries": 4096
  },
  "network": {
    "tcp_allow": [
      {
        "host": "auth.docker.io",
        "port": 443
      },
      {
        "host": "registry-1.docker.io",
        "port": 443
      },
      {
        "host": "production.cloudflare.docker.com",
        "port": 443
      },
      {
        "host": "production.cloudfront.docker.com",
        "port": 443
      }
    ]
  }
}
