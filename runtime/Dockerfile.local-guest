# syntax=docker/dockerfile:1.7
FROM rust:1.98.1-alpine@sha256:7cc1c22d77d9432f7fe012a70e6d3e555af54c2a6832700ed7d553f1769ae89f AS helper
RUN apk add --no-cache build-base perl
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY proto ./proto
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --locked --bin kata-workspace \
    && install -D target/release/kata-workspace /out/kata-workspace

FROM docker@sha256:9e79b879b177fbd72c34376a3dd3d91747da5db49e1f560f76aea59561471977
RUN apk add --no-cache openssh-server openssh-sftp-server bash coreutils curl iproute2 bind-tools netcat-openbsd \
    && addgroup -g 1000 sandbox \
    && adduser -D -h /sandbox -u 1000 -G sandbox sandbox \
    && passwd -d sandbox \
    && mkdir -p /sandbox /run/guest-ssh \
    && chown 1000:1000 /sandbox
COPY --from=helper /out/kata-workspace /usr/local/bin/kata-workspace
COPY runtime/guest-init.sh /usr/local/sbin/openshell-kata-init
COPY runtime/sshd_config /etc/ssh/openshell-kata.conf
RUN chmod 755 /usr/local/sbin/openshell-kata-init
ENTRYPOINT ["/usr/local/sbin/openshell-kata-init"]
